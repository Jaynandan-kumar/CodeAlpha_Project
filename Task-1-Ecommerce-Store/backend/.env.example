# Server
PORT=5000
NODE_ENV=development

# MongoDB (REQUIRED)
# Local: mongodb://localhost:27017/shopverse
# Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/shopverse
MONGO_URI=mongodb://localhost:27017/shopverse

# JWT Secret (REQUIRED - use a strong random string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Frontend URL (for CORS in production)
FRONTEND_URL=http://localhost:3000
